@model mvcdemo.Models.empdeptview
@{
    ViewData["Title"] = "mixedobjpass";
}

<h1>mixedobjpass</h1>

<h2> Date : @Model.date</h2> 
<h3> Dept Details</h3>

<table border="1" cellpadding="2" cellspacing="3">
    <tr>
        <td>DeptId</td>
        <td>DeptName</td>

    </tr>
    @foreach(var dept in Model.deptlist){
        <tr>
            <td>@dept.DeptId</td>
            <td>@dept.DeptName</td>
        </tr>
    }
</table>

<h3>Search Employee </h3>

<h1> Name : @Model.emp.EmpName</h1>
<div>
<img src="@Model.emp.ImageUrl" alt=" @Model.emp.EmpName" width=" 300" height="300" />
</div>

<div>
    <h2> Employee Details</h2>

    <p>
        He is a actor who works in hollywood.
    </p>

    <h2> Salary : @Model.emp.Salary</h2>
</div>