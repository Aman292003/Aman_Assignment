@model IEnumerable<mvcdemo.Models.Employee>

<h2>Employees in Department</h2>

@foreach (var emp in Model)
{
    <h1>Name : @emp.EmpName</h1>

    <div>
        <img src="@emp.ImageUrl" alt="@emp.EmpName" width="300" height="300" />
    </div>

    <div>
        <h2>Employee Details</h2>

        <p>
            He is an actor who works in Hollywood.
        </p>

        <h2>Salary : @emp.Salary</h2>

        <h2>
            <a asp-action="collectionofdept">Back to List</a>
        </h2>
    </div>
}