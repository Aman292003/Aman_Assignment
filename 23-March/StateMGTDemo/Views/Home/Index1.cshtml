
@{
    ViewData["Title"] = "Index1";
}

<h1>Index1</h1>

<h2>Index1 Page</h2>

@if (ViewBag.MyKey != null)
{
    <p style="color:blue; font-weight:bold;">
        TempData Value: @ViewBag.MyKey
    </p>
}
else
{
    <p style="color:red;">
        No data found in TempData
    </p>
}

<br />

<a asp-action="Index">Back to Index</a>

