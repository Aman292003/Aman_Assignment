@{
    ViewData["Title"] = "Dashboard";
}

<section class="hero-panel">
    <div class="hero-grid">
        <div>
            <p class="eyebrow">Product operations</p>
            <h2 class="hero-title">Manage your catalog with a cleaner, sharper workspace.</h2>
            <p class="hero-copy">
                Search products, review pricing, and jump into details, edits, or deletes from one focused dashboard.
            </p>
            <div class="hero-actions">
                <a href="/ProductUI/Create" class="btn-brand">Add New Product</a>
                <a href="#catalog" class="btn-ghost">Browse Catalog</a>
            </div>
        </div>

        <div class="hero-stat-card">
            <p class="eyebrow mb-1">Live inventory</p>
            <div class="hero-stat-value" id="productCount">0</div>
            <p class="hero-stat-note">Products currently visible in your workspace.</p>
        </div>
    </div>
</section>

<section class="content-panel" id="catalog">
    <div class="toolbar">
        <div>
            <h3 class="toolbar-title">Product Catalog</h3>
            <p class="toolbar-copy">Filter by product name and work directly from the table.</p>
        </div>

        <div class="search-shell">
            <input type="text" id="searchText" class="form-control" placeholder="Search by name" />
            <button id="btnSearch" type="button" class="btn-brand">Search</button>
        </div>
    </div>

    <div class="table-shell">
        <table class="table product-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="productTableBody">
                <tr>
                    <td colspan="5" class="empty-state">Loading products...</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script>
        function loadProducts(search = "") {
            $.ajax({
                url: `/api/Product`,
                type: "GET",
                success: function (data) {
                    let rows = "";

                    if (search) {
                        data = data.filter(p =>
                            p.name.toLowerCase().includes(search.toLowerCase())
                        );
                    }

                    $("#productCount").text(data.length);

                    if (data.length === 0) {
                        rows = "<tr><td colspan='5' class='empty-state'>No products matched your search.</td></tr>";
                    } else {
                        $.each(data, function (i, prod) {
                            rows += `
                                <tr>
                                    <td>#${prod.id}</td>
                                    <td class="name-cell">
                                        <strong>${prod.name}</strong>
                                        <span>Inventory item</span>
                                    </td>
                                    <td><span class="price-pill">Rs. ${prod.price}</span></td>
                                    <td><span class="category-pill">${prod.category}</span></td>
                                    <td>
                                        <div class="actions-row">
                                            <a href="/ProductUI/Details?id=${prod.id}" class="table-action info">Details</a>
                                            <a href="/ProductUI/Edit?id=${prod.id}" class="table-action warning">Edit</a>
                                            <a href="/ProductUI/Delete?id=${prod.id}" class="table-action danger">Delete</a>
                                        </div>
                                    </td>
                                </tr>`;
                        });
                    }

                    $("#productTableBody").html(rows);
                },
                error: function () {
                    alert("Failed to load data.");
                }
            });
        }

        function reload() {
            const search = $("#searchText").val();
            loadProducts(search);
        }

        $(document).ready(function () {
            reload();

            $("#btnSearch").click(function () {
                reload();
            });

            $("#searchText").keypress(function (e) {
                if (e.which === 13) {
                    e.preventDefault();
                    reload();
                }
            });
        });
    </script>
}
