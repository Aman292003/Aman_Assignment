
@{
    ViewData["Title"] = "Index2";
}

<h1>Index2</h1>
<h2>Index2 Page</h2>

@if (ViewBag.MyKey != null)
{
    <p style="color:red; font-weight:bold;">
        TempData Value: @ViewBag.MyKey
    </p>
}
else
{
    <p style="color:cornflowerblue;">
        No data found in TempData
    </p>
}

<br />

<a asp-action="Index">Back to Index</a>
