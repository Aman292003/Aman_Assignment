@{
    ViewBag.Title = "Employee Details";
    var empId = ViewBag.EmployeeId;
}

<h3 class="mb-3">Employee Details</h3>

<div class="card shadow">
    <div class="card-header bg-primary text-white text-center">
        <h4 id="empName">Loading...</h4>
    </div>

    <div class="card-body text-center">

        <!-- Loader -->
        <div id="loader">
            <div class="spinner-border text-primary"></div>
        </div>

        <!-- Image -->
        <img id="empImage"
             src="/uploads/default.jpeg"
             class="img-fluid mb-3 rounded d-none"
             style="width:300px;"
             onerror="this.onerror=null; this.src='/uploads/default.jpeg';" />

        <!-- Details -->
        <div id="empDetails" class="d-none">
            <p><strong>Email:</strong> <span id="empEmail"></span></p>
            <p><strong>Age:</strong> <span id="empAge"></span></p>

            <div class="mt-3">
                <a id="editBtn" class="btn btn-warning">Edit</a>
                <a id="deleteBtn" class="btn btn-danger">Delete</a>
                <a href="/EmployeeUI/Index" class="btn btn-secondary">Back</a>
            </div>
        </div>

    </div>
</div>

<script>
    const id = @empId;

    $(document).ready(function () {

        $.ajax({
            url: `/api/Emp/${id}`,
            type: "GET",
            success: function (emp) {

                $("#loader").hide();

                $("#empName").text(emp.firstName + " " + emp.lastName);
                $("#empEmail").text(emp.email);
                $("#empAge").text(emp.age);

                // 🔥 Correct image logic for uploads folder
                let imgPath = emp.imagePath;

                if (!imgPath || imgPath.trim() === "") {
                    imgPath = "/uploads/default.png";
                } else {
                    // if backend returns only filename or relative path
                    if (!imgPath.startsWith("http") && !imgPath.startsWith("/uploads")) {
                        imgPath = "/uploads/" + imgPath;
                    }
                }

                $("#empImage")
                    .attr("src", imgPath)
                    .removeClass("d-none");

                $("#empDetails").removeClass("d-none");

                $("#editBtn").attr("href", `/EmployeeUI/Edit?id=${id}`);
                $("#deleteBtn").attr("href", `/EmployeeUI/Delete?id=${id}`);
            },
            error: function () {
                $("#loader").hide();
                $(".card-body").html(`
                    <div class="alert alert-danger text-center">
                        ❌ Failed to load employee details
                    </div>
                    <a href="/EmployeeUI/Index" class="btn btn-secondary mt-3">Back</a>
                `);
            }
        });

    });
</script>