@{
    ViewBag.Title = "Delete Employee";
    var empId = ViewBag.EmployeeId;
}

<h3>Delete Employee</h3>

<div class="card">
    <div class="card-header bg-danger text-white">
        Confirm Delete
    </div>

    <div class="card-body text-center">
        <img id="empImage" src="" style="width:300px;" class="img-fluid mb-3" />

        <h4 id="empName"></h4>
        <p id="empEmail"></p>

        <button id="btnDelete" class="btn btn-danger">Delete</button>
        <a href="/EmployeeUI/Index" class="btn btn-secondary">Cancel</a>
    </div>
</div>

<script>
    const id = @empId;

    // 🔹 Load employee data
    $(document).ready(function () {
        $.ajax({
            url: `/api/Emp/${id}`,
            type: "GET",
            success: function (emp) {
                $("#empName").text(emp.firstName + " " + emp.lastName);
                $("#empEmail").text(emp.email);
                   var img = $("#empImage");

    img.attr("src", emp.imagePath ? emp.imagePath : "/uploads/default.jpeg");

    img.on("error", function () {
        $(this).attr("src", "/uploads/default.jpeg");
    });
            }
        });
    });

    // 🔹 Delete employee
    $("#btnDelete").click(function () {
        if (!confirm("Are you sure you want to delete this employee?")) return;

        $.ajax({
            url: `/api/Emp/${id}`,
            type: "DELETE",
            success: function () {
                alert("Employee deleted successfully!");
                window.location.href = "/EmployeeUI/Index";
            },
            error: function () {
                alert("Delete failed");
            }
        });
    });
</script>