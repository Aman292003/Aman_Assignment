@model IEnumerable<mvcefdemo.Models.ProdCat>

@{
    ViewData["Title"] = "ProductInCategory";
}

<div class="container mt-5">
    <h1 class="text-center mb-5 text-primary fw-bold">Products by Category</h1>

    <!-- Search Form -->
    <div class="row justify-content-center mb-5">
        <div class="col-md-6">
            <form action="/NORTHWNDController1/ProductInCategory" method="get" class="d-flex">
                <input type="text" name="categoryname" class="form-control me-2" placeholder="Enter Category" />
                <button type="submit" class="btn btn-success">Search</button>
            </form>
        </div>
    </div>

    <!-- Products Display -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm border-0">
                        <!-- Placeholder image -->
                        <img src="https://via.placeholder.com/200x150.png?text=Product" class="card-img-top" alt="@item.prodname">
                        <div class="card-body d-flex flex-column bg-light">
                            <h5 class="card-title text-primary fw-bold">@item.prodname</h5>
                            <p class="card-text text-secondary">@item.catname</p>
                            <a href="#" class="btn btn-outline-primary mt-auto">View Details</a>
                        </div>
                        <div class="card-footer text-center bg-success text-white fw-bold">
                            Available
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center mt-5">
            <p class="text-muted fs-5">No products found for the selected category.</p>
        </div>
    }
</div>