@model IEnumerable<LayoutAndSection.Models.Department>

@{
    ViewData["Title"] = "Department Index";
   
}

<h1>@ViewData["Title"]</h1>

@section HyperlinkTags {
    <ol>
        <li><a href="/Emp/Index">Employee Data</a></li>
        <li><a href="/Dept/Index">Department Data</a></li>
    </ol>
}

<p>
    <a asp-action="Create">Create New Department</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.DeptID)</th>
            <th>@Html.DisplayNameFor(model => model.DeptName)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.DeptID)</td>
                <td>@Html.DisplayFor(modelItem => item.DeptName)</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.DeptID }) |
                    @Html.ActionLink("Details", "Details", new { id = item.DeptID }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.DeptID })
                </td>
            </tr>
        }
    </tbody>
</table>