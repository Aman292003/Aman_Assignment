@model PartialViewEFdemo.Models.Employee

<h1>displayemp</h1>

<div style="border:solid 3px; padding:15px;">
    
    <div>
        <h3>Name: @Model.EmpName</h3>
        <p>ID: @Model.EmpId</p>
        <p>Email: @Model.Email</p>
    </div>

    <div>
        <h3>Description</h3>
        <p>@Model.Description</p>
    </div>

</div>