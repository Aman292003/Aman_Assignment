@{
    ViewBag.Title = "Person Hub";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #f4efe8;
            --bg-accent: #fff9f3;
            --panel: rgba(255, 255, 255, 0.72);
            --panel-strong: rgba(255, 255, 255, 0.92);
            --text: #14213d;
            --muted: #64748b;
            --line: rgba(20, 33, 61, 0.1);
            --shadow: 0 24px 80px rgba(20, 33, 61, 0.14);
            --primary: #ef6c3e;
            --primary-deep: #d94f1f;
            --secondary: #0f766e;
            --secondary-soft: #ccfbf1;
            --warning: #f59e0b;
            --danger: #dc2626;
            --success: #16a34a;
            --radius-xl: 28px;
            --radius-lg: 22px;
            --radius-md: 16px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Outfit", sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at top left, rgba(239, 108, 62, 0.18), transparent 30%),
                radial-gradient(circle at top right, rgba(15, 118, 110, 0.15), transparent 28%),
                linear-gradient(180deg, #fffaf4 0%, #f4efe8 45%, #efe5d7 100%);
            overflow-x: hidden;
        }

        body::before,
        body::after {
            content: "";
            position: fixed;
            inset: auto;
            border-radius: 999px;
            filter: blur(12px);
            pointer-events: none;
            z-index: 0;
        }

        body::before {
            width: 18rem;
            height: 18rem;
            top: 6%;
            right: -4rem;
            background: rgba(239, 108, 62, 0.16);
        }

        body::after {
            width: 16rem;
            height: 16rem;
            bottom: 5%;
            left: -5rem;
            background: rgba(15, 118, 110, 0.12);
        }

        .page-shell {
            position: relative;
            z-index: 1;
            width: min(1180px, calc(100% - 2rem));
            margin: 0 auto;
            padding: 2rem 0 3rem;
        }

        .hero {
            display: grid;
            grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.8fr);
            gap: 1.5rem;
            align-items: stretch;
            margin-bottom: 1.5rem;
        }

        .hero-card,
        .panel,
        .table-card {
            background: var(--panel);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: var(--shadow);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        .hero-card {
            border-radius: var(--radius-xl);
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

        .hero-card::after {
            content: "";
            position: absolute;
            inset: auto -3rem -3rem auto;
            width: 13rem;
            height: 13rem;
            background: linear-gradient(135deg, rgba(239, 108, 62, 0.25), rgba(15, 118, 110, 0.18));
            border-radius: 40px;
            transform: rotate(14deg);
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.45rem 0.8rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.74);
            color: var(--secondary);
            font-size: 0.92rem;
            font-weight: 600;
            letter-spacing: 0.02em;
        }

        .hero h1 {
            margin: 1rem 0 0.75rem;
            font-size: clamp(2.2rem, 5vw, 4.4rem);
            line-height: 0.96;
            letter-spacing: -0.05em;
            max-width: 10ch;
        }

        .hero p {
            margin: 0;
            max-width: 54ch;
            color: var(--muted);
            font-size: 1.04rem;
            line-height: 1.7;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.85rem;
            margin-top: 1.5rem;
        }

        .btn {
            border: 0;
            border-radius: 999px;
            padding: 0.9rem 1.25rem;
            font-family: inherit;
            font-size: 0.98rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, color 0.2s ease;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        .btn-primary {
            color: #fff;
            background: linear-gradient(135deg, var(--primary), var(--primary-deep));
            box-shadow: 0 18px 30px rgba(217, 79, 31, 0.22);
        }

        .btn-secondary {
            color: var(--text);
            background: rgba(255, 255, 255, 0.88);
            border: 1px solid rgba(20, 33, 61, 0.08);
        }

        .hero-side {
            display: grid;
            gap: 1rem;
        }

        .stat-card {
            border-radius: var(--radius-lg);
            padding: 1.35rem;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.72));
            border: 1px solid rgba(255, 255, 255, 0.7);
            box-shadow: var(--shadow);
        }

        .stat-label {
            color: var(--muted);
            font-size: 0.9rem;
            margin-bottom: 0.55rem;
        }

        .stat-value {
            font-size: clamp(1.8rem, 3vw, 2.6rem);
            font-weight: 800;
            letter-spacing: -0.04em;
            margin-bottom: 0.45rem;
        }

        .stat-hint {
            color: var(--muted);
            font-size: 0.95rem;
        }

        .content-grid {
            display: grid;
            grid-template-columns: minmax(320px, 0.95fr) minmax(0, 1.45fr);
            gap: 1.5rem;
            align-items: start;
        }

        .panel,
        .table-card {
            border-radius: var(--radius-xl);
            padding: 1.5rem;
        }

        .panel-header,
        .table-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.25rem;
        }

        .panel-title {
            margin: 0;
            font-size: 1.3rem;
            letter-spacing: -0.03em;
        }

        .panel-copy {
            margin: 0.4rem 0 0;
            color: var(--muted);
            line-height: 1.6;
        }

        .status-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.55rem 0.85rem;
            min-width: 110px;
            border-radius: 999px;
            background: rgba(15, 118, 110, 0.12);
            color: var(--secondary);
            font-weight: 700;
            font-size: 0.88rem;
        }

        .status-pill.is-editing {
            background: rgba(245, 158, 11, 0.16);
            color: #9a6700;
        }

        .form-grid {
            display: grid;
            gap: 1rem;
        }

        .field {
            display: grid;
            gap: 0.5rem;
        }

        .field label {
            font-size: 0.94rem;
            font-weight: 600;
            color: #334155;
        }

        .field input {
            width: 100%;
            border: 1px solid rgba(20, 33, 61, 0.08);
            border-radius: 16px;
            padding: 0.95rem 1rem;
            background: rgba(255, 255, 255, 0.92);
            color: var(--text);
            outline: none;
            font: inherit;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .field input:focus {
            border-color: rgba(239, 108, 62, 0.6);
            box-shadow: 0 0 0 4px rgba(239, 108, 62, 0.12);
            transform: translateY(-1px);
        }

        .action-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 0.25rem;
        }

        .mini-note {
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.6;
            margin: 0.15rem 0 0;
        }

        .table-meta {
            color: var(--muted);
            font-size: 0.95rem;
            margin-top: 0.35rem;
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 720px;
        }

        thead th {
            text-align: left;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--muted);
            padding: 0 0.9rem 0.95rem;
            border-bottom: 1px solid var(--line);
        }

        tbody td {
            padding: 1rem 0.9rem;
            border-bottom: 1px solid rgba(20, 33, 61, 0.07);
            vertical-align: middle;
        }

        tbody tr {
            transition: transform 0.2s ease, background 0.2s ease;
        }

        tbody tr:hover {
            background: rgba(255, 255, 255, 0.55);
        }

        .name-cell {
            display: grid;
            gap: 0.2rem;
        }

        .name-main {
            font-weight: 700;
        }

        .name-sub {
            color: var(--muted);
            font-size: 0.92rem;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.4rem 0.7rem;
            border-radius: 999px;
            background: rgba(15, 118, 110, 0.1);
            color: var(--secondary);
            font-size: 0.85rem;
            font-weight: 700;
        }

        .table-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .btn-small {
            padding: 0.65rem 0.9rem;
            font-size: 0.88rem;
        }

        .btn-edit {
            background: rgba(15, 118, 110, 0.12);
            color: var(--secondary);
        }

        .btn-delete {
            background: rgba(220, 38, 38, 0.1);
            color: var(--danger);
        }

        .empty-state,
        .loading-state {
            padding: 2rem 1rem;
            text-align: center;
            color: var(--muted);
        }

        .empty-state strong,
        .loading-state strong {
            display: block;
            color: var(--text);
            font-size: 1.05rem;
            margin-bottom: 0.4rem;
        }

        .toast {
            position: fixed;
            right: 1rem;
            bottom: 1rem;
            max-width: min(92vw, 360px);
            padding: 1rem 1.1rem;
            border-radius: 18px;
            color: #fff;
            font-weight: 600;
            box-shadow: 0 16px 45px rgba(20, 33, 61, 0.2);
            opacity: 0;
            transform: translateY(18px);
            pointer-events: none;
            transition: opacity 0.25s ease, transform 0.25s ease;
            z-index: 4;
        }

        .toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        .toast.success {
            background: linear-gradient(135deg, #16a34a, #15803d);
        }

        .toast.error {
            background: linear-gradient(135deg, #dc2626, #991b1b);
        }

        .table-toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .soft-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.8rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.74);
            color: var(--muted);
            border: 1px solid rgba(20, 33, 61, 0.06);
            font-size: 0.88rem;
            font-weight: 600;
        }

        @@media (max-width: 960px) {
            .hero,
            .content-grid {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                max-width: none;
            }
        }

        @@media (max-width: 640px) {
            .page-shell {
                width: min(100% - 1rem, 1180px);
                padding-top: 1rem;
            }

            .hero-card,
            .panel,
            .table-card {
                padding: 1.2rem;
                border-radius: 24px;
            }

            .panel-header,
            .table-header,
            .table-toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .action-row,
            .hero-actions {
                flex-direction: column;
            }

            .btn,
            .btn-small {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    
    <main class="page-shell">
        <section class="hero">
            <article class="hero-card">
                <span class="eyebrow">Live records workspace</span>
                <h1>Design-forward person management.</h1>
                <p>
                    A cleaner, warmer dashboard for adding, editing, and reviewing people in one place.
                    The data flow still talks to your existing API, but the experience now feels more polished,
                    more modern, and easier to scan on desktop and mobile.
                </p>
                <div class="hero-actions">
                    <button type="button" class="btn btn-primary" onclick="scrollToForm()">Add a new person</button>
                    <button type="button" class="btn btn-secondary" onclick="loadData(true)">Refresh live data</button>
                </div>
            </article>

            <aside class="hero-side">
                <div class="stat-card">
                    <div class="stat-label">Total people</div>
                    <div class="stat-value" id="totalPeople">0</div>
                    <div class="stat-hint">Auto-updates whenever data changes.</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Average age</div>
                    <div class="stat-value" id="averageAge">0</div>
                    <div class="stat-hint">Calculated from your current records.</div>
                </div>
            </aside>
        </section>

        <section class="content-grid">
            <article class="panel" id="personFormPanel">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">Create or update a profile</h2>
                        <p class="panel-copy">
                            Add new people quickly or switch into edit mode from the table to update an existing record.
                        </p>
                    </div>
                    <span class="status-pill" id="formStatus">Create mode</span>
                </div>

                <input type="hidden" id="personId" />

                <div class="form-grid">
                    <div class="field">
                        <label for="name">Full name</label>
                        <input type="text" id="name" placeholder="Aman Anand" maxlength="100" />
                    </div>

                    <div class="field">
                        <label for="email">Email address</label>
                        <input type="email" id="email" placeholder="aman@example.com" maxlength="150" />
                    </div>

                    <div class="field">
                        <label for="phone">Phone number</label>
                        <input type="tel" id="phone" placeholder="+91 98765 43210" maxlength="15" />
                    </div>

                    <div class="field">
                        <label for="age">Age</label>
                        <input type="number" id="age" placeholder="24" min="0" max="120" />
                    </div>

                    <div class="action-row">
                        <button type="button" class="btn btn-primary" id="saveButton" onclick="savePerson()">Save person</button>
                        <button type="button" class="btn btn-secondary" onclick="resetForm()">Reset form</button>
                    </div>

                    <p class="mini-note">
                        Tip: selecting <strong>Edit</strong> in the records table loads the row into this form so you can update it without leaving the page.
                    </p>
                </div>
            </article>

            <article class="table-card">
                <div class="table-header">
                    <div>
                        <h2 class="panel-title">People directory</h2>
                        <p class="panel-copy">
                            A calmer table layout with clearer hierarchy, quick actions, and better spacing for real-world use.
                        </p>
                    </div>
                </div>

                <div class="table-toolbar">
                    <span class="soft-chip">Connected to <strong>/api/Person</strong></span>
                    <div class="table-meta" id="recordSummary">No records loaded yet.</div>
                </div>

                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Person</th>
                                <th>Phone</th>
                                <th>Age</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="personTable">
                            <tr>
                                <td colspan="6" class="loading-state">
                                    <strong>Loading people...</strong>
                                    Pulling the latest records from the API.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </article>
        </section>
    </main>

    <div class="toast" id="toast"></div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        const baseUrl = "/api/Person";

        $(document).ready(function () {
            loadData();
        });

        function scrollToForm() {
            document.getElementById("personFormPanel").scrollIntoView({ behavior: "smooth", block: "start" });
            document.getElementById("name").focus();
        }

        function getPayload() {
            return {
                personId: parseInt($("#personId").val() || "0"),
                name: $("#name").val().trim(),
                email: $("#email").val().trim(),
                phone: $("#phone").val().trim(),
                age: parseInt($("#age").val() || "0")
            };
        }

        function validatePayload(payload) {
            if (!payload.name) {
                showToast("Please enter a name before saving.", "error");
                $("#name").focus();
                return false;
            }

            if (!payload.email) {
                showToast("Please enter an email address.", "error");
                $("#email").focus();
                return false;
            }

            if (!payload.phone) {
                showToast("Please enter a phone number.", "error");
                $("#phone").focus();
                return false;
            }

            if (Number.isNaN(payload.age) || payload.age < 0) {
                showToast("Please enter a valid age.", "error");
                $("#age").focus();
                return false;
            }

            return true;
        }

        function savePerson() {
            const payload = getPayload();

            if (!validatePayload(payload)) {
                return;
            }

            const isEditing = payload.personId > 0;

            $.ajax({
                url: baseUrl,
                type: isEditing ? "PUT" : "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function () {
                    showToast(isEditing ? "Person updated successfully." : "Person created successfully.", "success");
                    resetForm(false);
                    loadData();
                },
                error: function (xhr) {
                    const message = xhr.responseText || "Something went wrong while saving.";
                    showToast(message, "error");
                }
            });
        }

        function loadData(showRefreshToast) {
            $("#personTable").html(`
                <tr>
                    <td colspan="6" class="loading-state">
                        <strong>Loading people...</strong>
                        Pulling the latest records from the API.
                    </td>
                </tr>`);

            $.get(baseUrl, function (data) {
                renderRows(data || []);
                updateStats(data || []);

                if (showRefreshToast) {
                    showToast("Directory refreshed.", "success");
                }
            }).fail(function () {
                $("#personTable").html(`
                    <tr>
                        <td colspan="6" class="empty-state">
                            <strong>Could not load records.</strong>
                            Please check whether the API is running and try again.
                        </td>
                    </tr>`);
                $("#recordSummary").text("Unable to load records.");
                updateStats([]);
                showToast("Could not load data from the API.", "error");
            });
        }

        function renderRows(data) {
            if (!data.length) {
                $("#personTable").html(`
                    <tr>
                        <td colspan="6" class="empty-state">
                            <strong>No people added yet.</strong>
                            Use the form on the left to create your first record.
                        </td>
                    </tr>`);
                $("#recordSummary").text("0 records in the directory.");
                return;
            }

            let rows = "";

            data.forEach(function (p) {
                const createdDate = p.createdDate ? new Date(p.createdDate).toLocaleDateString() : "N/A";
                rows += `
                    <tr>
                        <td>#${p.personId}</td>
                        <td>
                            <div class="name-cell">
                                <span class="name-main">${escapeHtml(p.name)}</span>
                                <span class="name-sub">${escapeHtml(p.email || "No email available")}</span>
                            </div>
                        </td>
                        <td>${escapeHtml(p.phone || "-")}</td>
                        <td><span class="badge">${p.age ?? 0} yrs</span></td>
                        <td>${createdDate}</td>
                        <td>
                            <div class="table-actions">
                                <button type="button" class="btn btn-small btn-edit" onclick="editPerson(${p.personId})">Edit</button>
                                <button type="button" class="btn btn-small btn-delete" onclick="deletePerson(${p.personId})">Delete</button>
                            </div>
                        </td>
                    </tr>`;
            });

            $("#personTable").html(rows);
            $("#recordSummary").text(`${data.length} record${data.length === 1 ? "" : "s"} in the directory.`);
        }

        function updateStats(data) {
            const total = data.length;
            const average = total ? Math.round(data.reduce((sum, person) => sum + (person.age || 0), 0) / total) : 0;

            $("#totalPeople").text(total);
            $("#averageAge").text(average);
        }

        function editPerson(id) {
            $.get(`${baseUrl}/${id}`, function (p) {
                $("#personId").val(p.personId);
                $("#name").val(p.name);
                $("#email").val(p.email);
                $("#phone").val(p.phone);
                $("#age").val(p.age);
                setEditMode(true);
                scrollToForm();
                showToast(`Editing ${p.name}.`, "success");
            }).fail(function () {
                showToast("Could not load that record for editing.", "error");
            });
        }

        function deletePerson(id) {
            if (!confirm("Delete this record?")) {
                return;
            }

            $.ajax({
                url: `${baseUrl}/${id}`,
                type: "DELETE",
                success: function () {
                    showToast("Person deleted successfully.", "success");
                    if (parseInt($("#personId").val() || "0") === id) {
                        resetForm(false);
                    }
                    loadData();
                },
                error: function (xhr) {
                    const message = xhr.responseText || "Could not delete this record.";
                    showToast(message, "error");
                }
            });
        }

        function resetForm(showMessage) {
            $("#personId").val("");
            $("#name").val("");
            $("#email").val("");
            $("#phone").val("");
            $("#age").val("");
            setEditMode(false);

            if (showMessage !== false) {
                showToast("Form reset.", "success");
            }
        }

        function setEditMode(isEditing) {
            const status = $("#formStatus");
            const saveButton = $("#saveButton");

            if (isEditing) {
                status.text("Edit mode").addClass("is-editing");
                saveButton.text("Update person");
            } else {
                status.text("Create mode").removeClass("is-editing");
                saveButton.text("Save person");
            }
        }

        function showToast(message, type) {
            const toast = $("#toast");
            toast.removeClass("success error show").addClass(type).text(message);

            setTimeout(function () {
                toast.addClass("show");
            }, 10);

            clearTimeout(window.toastTimer);
            window.toastTimer = setTimeout(function () {
                toast.removeClass("show");
            }, 2800);
        }

        function escapeHtml(value) {
            return String(value ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }
    </script>
</body>
</html>
